---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/pixelify-sans/500.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Coding Dungeon is preparing something new." />
		<meta name="generator" content={Astro.generator} />
		<title>CODING_DUNGEON | Under Construction</title>
	</head>
	<body>
		<main class="construction-page">
			<section class="construction-content" aria-labelledby="page-title">
				<h1 id="page-title" class="sr-only">Coding Dungeon</h1>
				<img
					class="wizard"
					src="/artwork/under-construction/pixel_wizard_coding_in_binary_rain.gif"
					width="362"
					height="362"
					fetchpriority="high"
					alt="A pixel wizard coding on a laptop while binary numbers fall around him"
				/>
				<img
					class="wordmark"
					src="/brand/coding_dungeon_letters.png"
					width="2172"
					height="724"
					decoding="async"
					alt="coding_dungeon"
				/>
				<p class="status" role="status">
					&gt; casting_spells<span class="cursor" aria-hidden="true">_</span>
				</p>
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html),
	:global(body) {
		margin: 0;
		min-width: 320px;
		min-height: 100%;
		background: #020301;
	}

	:global(body) {
		font-family: 'IBM Plex Mono', monospace;
	}

	.construction-page {
		position: relative;
		display: grid;
		min-height: 100svh;
		place-items: center;
		overflow: hidden;
		background-color: #020301;
		background-image: url('/artwork/under-construction/neon_green_dungeon_archway.png');
		background-position: center;
		background-repeat: no-repeat;
		background-size: cover;
	}

	.construction-content {
		position: relative;
		z-index: 1;
		display: flex;
		width: min(50rem, 90vw);
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 2rem;
		transform: translateY(-1.5rem);
	}

	.wizard {
		position: relative;
		z-index: 0;
		display: block;
		width: min(22rem, 42vw);
		height: auto;
		margin-bottom: -1.5rem;
		image-rendering: pixelated;
		transform: translateY(1.5rem);
	}

	.wordmark {
		position: relative;
		z-index: 1;
		display: block;
		width: min(35rem, 70vw);
		height: auto;
		margin-top: 0.25rem;
	}

	.status {
		margin: -0.1rem 0 0;
		color: #f4f4f4;
		font-family: 'IBM Plex Mono', monospace;
		font-size: clamp(1rem, 1.6vw, 1.45rem);
		line-height: 1.4;
		text-shadow: 0 0 0.75rem rgba(120, 255, 0, 0.3);
	}

	.status::first-letter {
		color: #8cff00;
	}

	.cursor {
		color: #8cff00;
		animation: cursor-blink 1s steps(2, jump-none) infinite;
	}

	@keyframes cursor-blink {
		50% {
			visibility: hidden;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}

	@media (max-width: 700px) {
		.construction-page {
			background-position: center bottom;
		}

		.construction-content {
			width: 100%;
			padding: max(1rem, env(safe-area-inset-top))
				max(1rem, env(safe-area-inset-right))
				max(1.25rem, env(safe-area-inset-bottom))
				max(1rem, env(safe-area-inset-left));
			transform: translateY(-0.5rem);
		}

		.wizard {
			width: min(22rem, 72vw);
			margin-bottom: -1.25rem;
			transform: translateY(1.25rem);
		}

		.wordmark {
			width: min(35rem, 88vw);
			margin-top: 0;
		}

		.status {
			max-width: 100%;
			margin-top: 0.1rem;
			font-size: clamp(0.9rem, 4.2vw, 1.15rem);
			white-space: nowrap;
		}
	}

	@media (min-width: 701px) and (max-height: 700px) {
		.construction-content {
			transform: translateY(-0.5rem);
		}

		.wizard {
			width: min(18rem, 34vw);
		}

		.wordmark {
			width: min(29rem, 60vw);
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
